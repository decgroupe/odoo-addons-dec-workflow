<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="mail_workflow_dec.view_email_template_notification" model="ir.ui.view">
        <field name="inherit_id" ref="mail_qweb.view_email_template_notification" />
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='content_border']" position="attributes">
                <attribute
                    name="style"
                >background-image: url(/mail_workflow_dec/static/img/footer.png);background-size: contain;background-position: center bottom;background-repeat: no-repeat;</attribute>
            </xpath>
        </field>
    </record>

</odoo>
