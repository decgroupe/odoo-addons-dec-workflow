<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="invoice_line_tree_view">
        <field name="name">account.move.line.tree@account_workflow_dec</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//sheet//notebook//tree/field[@name='quantity']"
                position="attributes"
            >
                <attribute name="sum">1</attribute>
            </xpath>
            <xpath
                expr="//sheet//notebook//tree/field[@name='price_unit']"
                position="attributes"
            >
                <attribute name="sum">1</attribute>
            </xpath>
            <xpath
                expr="//sheet//notebook//tree/field[@name='price_subtotal']"
                position="attributes"
            >
                <attribute name="sum">1</attribute>
            </xpath>
            <xpath
                expr="//sheet//notebook//tree/field[@name='price_total']"
                position="attributes"
            >
                <attribute name="sum">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
