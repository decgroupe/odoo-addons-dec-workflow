<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="calendar_event_form_view">
        <field name="name">calendar.event.form@calendar_workflow_dec</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_invitations']" position="attributes">
                <attribute name="groups" /> <!-- Remove the res.group on the group-->
            </xpath>
            <xpath expr="//page[@name='page_invitations']" position="attributes">
                <attribute name="page_misc" /> <!-- Remove the res.group on the group-->
            </xpath>
            <xpath expr="//field[@name='stop']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="string">Ending at</attribute>
                <attribute name="attrs">{'invisible': [('allday','=',True)]}</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="calendar_event_noshare_form_view">
        <field name="name">calendar.event.form#noshare@calendar_workflow_dec</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='page_misc']//field[@name='user_id']"
                position="attributes"
            >
                <attribute name="domain">[('share', '=', False)]</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="calendar_event_calendar_view">
        <field name="name">calendar.event.calendar@calendar_workflow_dec</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar" />
        <field name="arch" type="xml">
            <xpath expr="//calendar//field[@name='attendee_status']" position="before">
                <field name="partner_ids" position="move" />
            </xpath>
            <xpath
                expr="//calendar//field[@name='attendee_status']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//calendar//field[@name='privacy']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>


</odoo>
