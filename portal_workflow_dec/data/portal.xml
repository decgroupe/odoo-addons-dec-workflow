<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <function model="ir.model.data" name="write">
        <value
            model="ir.model.data"
            search="[
                ('module', '=', 'portal'),
                ('name', '=', 'mail_template_data_portal_welcome'),
            ]"
        />
        <value eval="{'noupdate': False}" />
    </function>

    <record model="mail.template" id="portal.mail_template_data_portal_welcome">
        <field name="body_type">qweb</field>
        <field name="body_view_id" ref="view_mail_template_data_portal_welcome" />
    </record>

</odoo>
