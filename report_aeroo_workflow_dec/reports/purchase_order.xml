<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <function model="ir.actions.report" name="unlink_action">
        <value eval="[ref('purchase.action_report_purchase_order')]" />
    </function>

    <function model="ir.actions.report" name="unlink_action">
        <value eval="[ref('purchase.report_purchase_quotation')]" />
    </function>

    <function model="mail.template" name="write">
        <value
            model="mail.template"
            search="
        [('id', '=', ref('purchase.email_template_edi_purchase'))]"
        />
        <value
            eval="{'report_template': ref('purchase_report_aeroo.purchase_order_report')}"
        />
    </function>

    <function model="mail.template" name="write">
        <value
            model="mail.template"
            search="
        [('id', '=', ref('purchase.email_template_edi_purchase_done'))]"
        />
        <value
            eval="{'report_template': ref('purchase_report_aeroo.purchase_order_report')}"
        />
    </function>

</odoo>
