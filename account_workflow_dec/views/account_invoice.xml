<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="invoice_tree_view">
        <field name="name">account.invoice.tree@account_workflow_dec</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="amount_untaxed_signed" position="attributes">
                <attribute name="string">Total Amount (excluding taxes)</attribute>
            </field>
            <field name="amount_total_signed" position="attributes">
                <attribute name="string">Total Amount (including taxes)</attribute>
            </field>
            <field name="amount_residual_signed" position="attributes">
                <attribute name="string">Amount Due (including taxes)</attribute>
            </field>
            <field name="amount_tax_signed" position="attributes">
                <attribute name="string">Taxes</attribute>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="widget">many2one_avatar</attribute>
                <attribute name="optional">hide</attribute>
                <attribute name="invisible">0</attribute>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="invoice_form_view">
        <field name="name">account.invoice.form@account_workflow_dec</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post'][1]" position="attributes">
                <attribute
                    name="confirm"
                >Are you sure that you want to validate this invoice?</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post'][2]" position="attributes">
                <attribute
                    name="confirm"
                >Are you sure that you want to validate this invoice?</attribute>
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute
                    name="confirm"
                >Are you sure that you want to cancel this invoice?</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="account_invoice_filter_view">
        <field name="name">account.invoice.select@account_workflow_dec</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <filter name="draft" position="before">
                <filter
                    name="filter_not_cancelled"
                    string="Not Cancelled"
                    domain="[('state', '!=', 'cancel')]"
                />
            </filter>
        </field>
    </record>

    <record model="ir.actions.act_window" id="account.action_move_out_invoice_type">
        <field
            name="context"
        >{'default_move_type':'out_invoice', "search_default_filter_not_cancelled": 1}</field>
    </record>

    <record model="ir.actions.act_window" id="account.action_move_in_invoice_type">
        <field
            name="context"
        >{'default_move_type': 'in_invoice', "search_default_filter_not_cancelled": 1}</field>
    </record>

    <record model="ir.ui.view" id="invoice_supplier_form_view">
        <field name="name">account.invoice.supplier.form@account_workflow_dec</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field
                    name="company_invoice_number"
                    attrs="{'invisible':[('move_type', 'not in', ('in_invoice', 'in_refund'))]}"
                />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="invoice_supplier_tree_view">
        <field name="name">account.invoice.tree@account_workflow_dec</field>
        <field name="model">account.move</field>
        <field name="type">tree</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree" />
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="company_invoice_number" />
            </field>
        </field>
    </record>

</odoo>
