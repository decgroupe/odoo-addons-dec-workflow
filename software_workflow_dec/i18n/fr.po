#. module: software_workflow_dec
#: model_terms:ir.ui.view,arch_db:software_workflow_dec.mail_notification_layout
msgid ""
"All your licences, subscriptions and applications are managed via the\n"
"                new \"e-space DEC\" launcher. You can find the software and documentation\n"
"                at this address :"
msgstr ""
"Toutes vos licences, abonnements et applications sont gérés via le.\n"
"                nouveau lanceur \"e-space DEC\". Vous trouverez le logiciel et sa documentation\n"
"                à cette adresse :"

