            <field name="zip">62704</field>
            <field name="country_id" ref="base.us" />
            <field name="tz">America/Chicago</field>
            <field name="email">jane.doe@yourcompany.example.com</field>
            <field name="phone">(555)-123-4567</field>
        </record>

        <record id="user_jd" model="res.users">
            <field name="partner_id" ref="project_workflow_dec.partner_jd" />
            <field name="login">jdoe</field>
            <field name="password">jdoe</field>
            <field name="signature" type="xml"><span>-- <br />+Jane Doe</span></field>
            <field
                name="groups_id"
