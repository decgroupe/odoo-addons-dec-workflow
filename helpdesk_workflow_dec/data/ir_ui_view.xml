<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="view_email_template_created_ticket_template">
        <t t-call="mail_qweb.view_email_template_notification">
            <t t-set="content_message">
                <div>
                    <p>Hello <t
                            t-esc="object.partner_id.name or object.partner_name or ''"
                        />,</p>
                    <p>The ticket « <small
                            t-esc="object.display_name or 'n/a'"
                        /> » has been created.</p>
                    <p>You can reply to this email to add information to the ticket.</p>
                </div>
            </t>
            <t t-set="content_message_action">
                <t t-if="object.partner_can_access()">
                    <a t-attf-href="{{object.get_access_link()}}" target="_blank">
                    View Ticket
                    </a>
                </t>
            </t>
            <!-- <t t-set="content_message_bottom">
                __ footer __
            </t> -->
            <t t-set="content_message_signature">
                <t t-if="user.signature">
                    <t t-raw="user.signature or ''" />
                </t>
            </t>
        </t>
    </template>

</odoo>
